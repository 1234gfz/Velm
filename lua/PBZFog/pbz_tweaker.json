{
  "version": 3,
  "title": "影之刃零 · 调参器",
  "hotkey": "F8",
  "groups": [
    {
      "name": "雾效",
      "desc": "按百分比缩放游戏原本的雾强度，100% = 游戏原版。",
      "parameters": [
        {
          "key": "fog.density",
          "label": "雾浓度",
          "type": "float",
          "min": 0,
          "max": 1.5,
          "step": 0.05,
          "default": 1,
          "value": 0.8,
          "handler": "fog",
          "target": "density",
          "hint": "控制整体雾浓度的主控项；100% = 游戏原版。",
          "display": "percent",
          "enabled": true,
          "sub": "整体强度"
        },
        {
          "key": "fog.maxopacity",
          "label": "雾最大不透明度（%）",
          "type": "float",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "default": 1,
          "value": 1,
          "handler": "fog",
          "target": "maxopacity",
          "hint": "100% = 原版，压低远处的雾更通透",
          "display": "percent",
          "enabled": false,
          "sub": "整体强度"
        },
        {
          "key": "fog.start",
          "label": "雾起始距离（米）",
          "type": "float",
          "min": 0,
          "max": 50000,
          "step": 500,
          "default": 5000,
          "value": 5000,
          "handler": "fog",
          "target": "startdistance",
          "hint": "游戏原值 50 米。这是雾开始变浓的起始距离，调大能把雾推远，300 米以上基本就看不到雾了",
          "uiScale": 0.01,
          "suffix": "m",
          "enabled": false,
          "sub": "整体强度"
        },
        {
          "key": "fog.extinction",
          "label": "体积雾消光",
          "type": "float",
          "min": 0,
          "max": 5,
          "step": 0.05,
          "default": 1,
          "value": 0.7,
          "handler": "fog",
          "target": "extinction",
          "hint": "控制体积雾的「厚度 / 吸收」，与雾浓度是两个不同维度，可叠加使用；100% = 原版。",
          "display": "percent",
          "enabled": true,
          "sub": "体积雾"
        },
        {
          "key": "fog.heightfall",
          "label": "高度衰减",
          "type": "float",
          "min": 0,
          "max": 0.5,
          "step": 0.005,
          "default": 0.069,
          "value": 0.09,
          "handler": "fog",
          "target": "heightfalloff",
          "hint": "游戏原值约 0.069。越大雾越贴地面，越大越不容易糊满整个画面",
          "enabled": true,
          "sub": "体积雾"
        },
        {
          "key": "fog.scatter",
          "label": "体积雾散射",
          "type": "float",
          "min": 0,
          "max": 1,
          "step": 0.05,
          "default": 0.2,
          "value": 0.2,
          "handler": "fog",
          "target": "scatter",
          "hint": "原值约 0.2。影响光雾的方向感和“厚”的感觉，调低会更柔和",
          "enabled": false,
          "sub": "体积雾"
        },
        {
          "key": "fog.voldist",
          "label": "体积雾距离",
          "type": "float",
          "min": 2000,
          "max": 20000,
          "step": 500,
          "default": 10000,
          "value": 10000,
          "handler": "fog",
          "target": "voldist",
          "hint": "原值 10000。调小能省性能，但远处的体积雾会提前消失",
          "enabled": false,
          "sub": "体积雾"
        },
        {
          "key": "fog.vstart",
          "label": "体积雾·起始距离",
          "type": "float",
          "min": 0,
          "max": 20000,
          "step": 500,
          "default": 0,
          "value": 0,
          "handler": "fog",
          "target": "volstart",
          "uiScale": 0.01,
          "suffix": "m",
          "hint": "体积雾从多少米外才开始出现（原值 0 = 贴脸就有）。调到 20~30 米可退掉房间近处的浓雾、远处照旧。经典雾的「起始距离」管不到体积雾。",
          "enabled": false,
          "sub": "体积雾"
        },
        {
          "key": "fog.vnearfade",
          "label": "体积雾·近场淡入",
          "type": "float",
          "min": 0,
          "max": 5000,
          "step": 100,
          "default": 0,
          "value": 0,
          "handler": "fog",
          "target": "volnearfade",
          "uiScale": 0.01,
          "suffix": "m",
          "hint": "让体积雾在起始距离附近平滑淡入，避免出现硬边/突变。配合上面的『起始距离』一起用，建议 5~10 米。",
          "enabled": false,
          "sub": "体积雾"
        }
      ]
    },
    {
      "name": "局部雾团",
      "desc": "场景里小范围飘动的雾是 Niagara 粒子（雾门、BOSS 房那种），可以整组关掉",
      "parameters": [
        {
          "key": "lfog.visible",
          "label": "显示雾团",
          "type": "bool",
          "default": true,
          "value": true,
          "handler": "lfog",
          "target": "visible",
          "hint": "关掉后所有名字带 Fog 的粒子雾都不渲染",
          "enabled": false,
          "sub": ""
        }
      ]
    },
    {
      "name": "画面",
      "desc": "直接写后处理体积的数值，绝对值不是倍率；改动要按右下角「应用」",
      "parameters": [
        {
          "key": "img.bloom",
          "label": "泛光",
          "type": "float",
          "min": 0,
          "max": 3,
          "step": 0.05,
          "default": 0.675,
          "value": 2,
          "handler": "pp",
          "target": "BloomIntensity",
          "hint": "游戏原值约 0.675，0 = 无泛光",
          "enabled": true,
          "sub": "泛光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": 0,
          "modes": [
            "abs",
            "ratio",
            "offset"
          ]
        },
        {
          "key": "img.bloomthr",
          "label": "泛光阈值",
          "type": "float",
          "min": -1,
          "max": 8,
          "step": 0.05,
          "default": -1,
          "value": 0.5,
          "handler": "pp",
          "target": "BloomThreshold",
          "hint": "原值 -1（-1 表示不设阈值，全画面都参与泛光）。调高后只有超过该亮度的部分才发光，能压掉灰蒙蒙的整体泛光",
          "enabled": true,
          "sub": "泛光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ]
        },
        {
          "key": "img.bloomsize",
          "label": "泛光最大扩散半径（%）",
          "type": "float",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 64,
          "value": 64,
          "handler": "pp",
          "target": "Bloom6Size",
          "hint": "原值 64。泛光由 6 级半径叠加而成，这是最大的一级，决定光晕能铺多远。UE 没有「泛光亮度上限」这个字段，这是最接近的一项",
          "enabled": false,
          "sub": "泛光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ]
        },
        {
          "key": "img.bloommethod",
          "label": "泛光算法",
          "type": "float",
          "min": 0,
          "max": 1,
          "step": 1,
          "default": 0,
          "value": 0,
          "handler": "pp",
          "target": "BloomMethod",
          "hint": "原值 0（标准：6 级 mip 叠加）。1 = FFT 卷积，下面那个预滤波上限只在 1 时生效",
          "enabled": false,
          "sub": "泛光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs"
          ],
          "advanced": true
        },
        {
          "key": "img.bloompfmax",
          "label": "泛光预滤波亮度上限",
          "type": "float",
          "min": 1,
          "max": 15000,
          "step": 10,
          "default": 15000,
          "value": 15000,
          "handler": "pp",
          "target": "BloomConvolutionPreFilterMax",
          "hint": "原值 15000。卷积预滤波的亮度上限，只在「泛光算法=1」时起作用；默认值很高等于不设限，往下压能抑制高光糊成一片",
          "enabled": false,
          "sub": "泛光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ]
        },
        {
          "key": "img.ca",
          "label": "色差",
          "type": "float",
          "min": 0,
          "max": 3,
          "step": 0.05,
          "default": 0,
          "value": 0,
          "handler": "pp",
          "target": "SceneFringeIntensity",
          "hint": "0 = 关掉边缘色散",
          "enabled": false,
          "sub": "其他",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": 0,
          "modes": [
            "abs",
            "ratio",
            "offset"
          ]
        },
        {
          "key": "img.flare",
          "label": "镜头光晕",
          "type": "float",
          "min": 0,
          "max": 3,
          "step": 0.05,
          "default": 0,
          "value": 0,
          "handler": "pp",
          "target": "LensFlareIntensity",
          "hint": "0 = 关闭",
          "enabled": false,
          "sub": "其他",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": 0,
          "modes": [
            "abs",
            "ratio",
            "offset"
          ]
        },
        {
          "key": "img.grain",
          "label": "胶片颗粒",
          "type": "float",
          "min": 0,
          "max": 2,
          "step": 0.05,
          "default": 0,
          "value": 0,
          "handler": "pp",
          "target": "FilmGrainIntensity",
          "hint": "0 = 去掉颗粒噪点",
          "enabled": false,
          "sub": "其他",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": 0,
          "modes": [
            "abs",
            "ratio",
            "offset"
          ]
        },
        {
          "key": "img.vignette",
          "label": "暗角",
          "type": "float",
          "min": 0,
          "max": 2,
          "step": 0.05,
          "default": 0.6,
          "value": 0.6,
          "handler": "pp",
          "target": "VignetteIntensity",
          "hint": "游戏原值约 0.4，0 = 四角不压暗",
          "enabled": true,
          "sub": "其他",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": 0,
          "modes": [
            "abs",
            "ratio",
            "offset"
          ]
        },
        {
          "key": "img.mblur",
          "label": "动态模糊",
          "type": "float",
          "min": 0,
          "max": 2,
          "step": 0.05,
          "default": 0.5,
          "value": 0.5,
          "handler": "pp",
          "target": "MotionBlurAmount",
          "hint": "游戏原值约 0.5，0 = 关掉拖影",
          "enabled": false,
          "sub": "其他",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": 0,
          "modes": [
            "abs",
            "ratio",
            "offset"
          ]
        }
      ]
    },
    {
      "name": "光照与色调",
      "desc": "曝光 / 局部曝光 / 色调映射 / 调色 / 环境光。这些参数依赖画质档位，档位低时可能不生效。",
      "parameters": [
        {
          "key": "gi.temp",
          "label": "色温",
          "type": "float",
          "min": 2000,
          "max": 12000,
          "step": 100,
          "default": 6500,
          "value": 6700,
          "handler": "pp",
          "target": "WhiteTemp",
          "hint": "6500 = 中性白；调低偏暖，调高偏冷",
          "enabled": true,
          "sub": "白平衡",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ]
        },
        {
          "key": "sun.intensity",
          "label": "平行光强度",
          "type": "float",
          "min": 0,
          "max": 3,
          "step": 0.05,
          "default": 1,
          "value": 0.15,
          "handler": "light",
          "hint": "场景主太阳（DirectionalLight）的强度倍率，界面按百分比显示：100% = 原始亮度，50% = 一半，200% = 两倍。和雾浓度的百分比是同一套机制（内部存小数，界面显示 %）。只作用于主光——场景里通常有 3 个方向光组件（Ultra Dynamic Sky 的太阳/月亮/补光），强度为 0 的是没启用的，这里会自动锁定强度最大的那个主太阳并持续跟踪，换关卡后重新锁定。关掉开关会还原成 100%。注意：场景亮度还有一部分来自天光（SkyLight），只调这个可能不足以完全压暗/提亮。",
          "enabled": true,
          "sub": "阳光",
          "display": "percent"
        },
        {
          "key": "gi.bias",
          "label": "曝光补偿",
          "type": "float",
          "min": -2,
          "max": 4,
          "step": 0.1,
          "default": 1,
          "value": 0,
          "handler": "pp",
          "target": "AutoExposureBias",
          "hint": "原值 1.0。这是最直接的“整体亮不亮”旋钮，比调间接光有效得多",
          "enabled": false,
          "sub": "曝光与测光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": 0,
          "modes": [
            "abs",
            "ratio",
            "offset"
          ]
        },
        {
          "key": "gi.evmin",
          "label": "自动曝光下限",
          "type": "float",
          "min": -20,
          "max": 20,
          "step": 0.5,
          "default": -10,
          "value": -13,
          "handler": "pp",
          "target": "AutoExposureMinBrightness",
          "hint": "原值 -10。这是自动曝光的“最暗能暗到哪”，调高会压制暗部提亮；范围 -20~20",
          "enabled": true,
          "sub": "曝光与测光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ]
        },
        {
          "key": "gi.evmax",
          "label": "自动曝光上限",
          "type": "float",
          "min": -20,
          "max": 60,
          "step": 0.5,
          "default": 20,
          "value": -1.5,
          "handler": "pp",
          "target": "AutoExposureMaxBrightness",
          "hint": "原值 20。这是自动曝光的“最亮能亮到哪”，调低能防止白天发白；范围 -20~60",
          "enabled": true,
          "sub": "曝光与测光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ]
        },
        {
          "key": "gi.evup",
          "label": "曝光变亮速度",
          "type": "float",
          "min": 0,
          "max": 10,
          "step": 0.1,
          "default": 3,
          "value": 3,
          "handler": "pp",
          "target": "AutoExposureSpeedUp",
          "hint": "原值 3.0。从亮处进暗处时画面变亮的速度，越大越快；调小过渡更慢更自然",
          "enabled": true,
          "sub": "曝光与测光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ]
        },
        {
          "key": "gi.evdown",
          "label": "曝光变暗速度",
          "type": "float",
          "min": 0,
          "max": 10,
          "step": 0.1,
          "default": 1,
          "value": 0.6,
          "handler": "pp",
          "target": "AutoExposureSpeedDown",
          "hint": "原值 1.0。从暗处进亮处时画面压下来的速度，越大越快；调小能减轻进出门时那种“闪一下”",
          "enabled": true,
          "sub": "曝光与测光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ]
        },
        {
          "key": "gi.evmode",
          "label": "测光模式（0直方图/1基础/2手动）",
          "type": "float",
          "min": 0,
          "max": 2,
          "step": 1,
          "default": 0,
          "value": 0,
          "handler": "pp",
          "target": "AutoExposureMethod",
          "hint": "原值 0（直方图）。2 = 手动，曝光完全固定、不再忽明忽暗，代价是进暗处就是暗的、不再自动提亮。可设 0 / 1 / 2，2 最激进。",
          "enabled": false,
          "sub": "曝光与测光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs"
          ],
          "advanced": true
        },
        {
          "key": "gi.lowpct",
          "label": "测光忽略暗部（%）",
          "type": "float",
          "min": 0,
          "max": 90,
          "step": 1,
          "default": 10,
          "value": 6,
          "handler": "pp",
          "target": "AutoExposureLowPercent",
          "hint": "调暗画面的主要杠杆。测光时排除最暗的 N% 像素：调大 → 排除更多暗部 → 测光值变亮 → 画面变暗。窗口（highpct − lowpct）别小于 15，否则曝光会抖。",
          "enabled": true,
          "sub": "曝光与测光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ]
        },
        {
          "key": "gi.highpct",
          "label": "测光忽略亮部（%）",
          "type": "float",
          "min": 50,
          "max": 100,
          "step": 1,
          "default": 90,
          "value": 93,
          "handler": "pp",
          "target": "AutoExposureHighPercent",
          "hint": "测光时排除最亮的 (100−N)% 像素：调大 → 砍掉更多高光尾部 → 画面变亮；调小 → 让高光参与测光 → 画面变暗（高光被压住）。",
          "enabled": true,
          "sub": "曝光与测光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ]
        },
        {
          "key": "gi.histmin",
          "label": "直方图下界（Log2 亮度）",
          "type": "float",
          "min": -20,
          "max": 0,
          "step": 0.5,
          "default": -8,
          "value": -12,
          "handler": "pp",
          "target": "HistogramLogMin",
          "hint": "直方图亮度统计的下边界，默认 −8（即 1/256）；低于该值的像素不进直方图。若 MinBrightness 压得很低仍无变化，把这个也往下调（−10、−12）。",
          "enabled": true,
          "sub": "曝光与测光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ]
        },
        {
          "key": "gi.histmax",
          "label": "直方图上界（Log2 亮度）",
          "type": "float",
          "min": 0,
          "max": 20,
          "step": 0.5,
          "default": 4,
          "value": 4,
          "handler": "pp",
          "target": "HistogramLogMax",
          "hint": "直方图上边界，默认 4（即 16）。亮部超过这个值的像素也不进统计。一般不用动，除非要压高光。",
          "enabled": false,
          "sub": "曝光与测光",
          "mode": "abs",
          "ratio": 100,
          "offset": 0,
          "origin": null,
          "modes": [
            "abs",
            "offset"
          ],
          "advanced": true
        },
        {
          "key": "gi.calconst",
          "label": "测光校准常数（18% 灰）",
          "type": "float",
          "min": 1,
          "max": 100,
          "step": 0.5,
          "default": 18,
          "value": 18,
          "handler": "pp",
          "target": "AutoExposureCalibrationConstant",
          "hint": "18% 中灰的校准常数，默认 18。调大 → 整体更暗；调小 → 整体更亮。这个值改变的是「引擎认为多亮算正常」的基准，所以比单纯压上下限更有效。",
          "enabled": false,
