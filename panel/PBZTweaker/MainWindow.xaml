<Window x:Class="PBZTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velm 小维 · 调参器" Width="620" Height="900"
        WindowStyle="None" AllowsTransparency="False" Background="#FF201F1E"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Visibility="Hidden" WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI" FontSize="20"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2B2926"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2B2926"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#5A5145"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F5F2EC"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F5F2EC"/>

        <!-- 彻底自绘的 ComboBox：默认模板在深色下必定出现白块 -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2B2926"/>
            <Setter Property="Foreground" Value="#DDD8D0"/>
            <Setter Property="BorderBrush" Value="#4A453E"/>
            <Setter Property="FontSize" Value="18.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#2B2926" BorderBrush="#4A453E"
                                                BorderThickness="1" CornerRadius="6">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Data="M0,0 L11,0 L5.5,7 Z" Fill="#7C766E"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="Sel" IsHitTestVisible="False"
                                              Margin="9,0,26,0" VerticalAlignment="Center"
                                              TextElement.Foreground="#F5F2EC"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#2B2926" BorderBrush="#4A453E" BorderThickness="1"
                                        CornerRadius="6" Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表项也自绘，避免悬停时变白 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#DDD8D0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="18.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4438"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A5145"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2B2926"/>
            <Setter Property="Foreground" Value="#DDD8D0"/>
            <Setter Property="BorderBrush" Value="#4A453E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#F5F2EC"/>
            <Setter Property="FontSize" Value="18.5"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="SoftSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="2.5" Background="#3F3B36" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#C0AF93" Stroke="#201F1E" StrokeThickness="1.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="关掉后恢复游戏原值，并且不再覆盖"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="10.5" Background="#3A3631"/>
                            <Border x:Name="Knob" Width="15" Height="15" CornerRadius="7.5"
                                    Background="#8A8378" HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C0AF93"/>
                                <Setter TargetName="Knob" Property="Background" Value="#201F1E"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="#F2201F1E" CornerRadius="14"
            BorderBrush="#2AFFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" x:Name="Header" Background="Transparent"
                    Padding="18,14,10,6" MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="影之刃零 · 调参器"
                                   Foreground="#FFE2DDD5" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubText" Text="F8 呼出面板"
                                   Foreground="#7C766E" FontSize="17" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ComboBox x:Name="LangBox" Width="96" Height="30" FontSize="15"
                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                  SelectionChanged="Lang_Changed"
                                  ToolTip="界面语言 / UI language">
                            <ComboBoxItem Content="中文"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                        <TextBlock x:Name="MasterLabel" Text="整体效果"
                                   Foreground="#C0AF93" FontSize="17"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ToggleButton x:Name="MasterSwitch" Width="44" Height="24"
                                      Style="{StaticResource SoftSwitch}"
                                      VerticalAlignment="Center"
                                      ToolTip="总开关。关掉后所有覆盖立刻撤销、画面回到游戏原版，但每个参数里调好的数值全部保留，打开就恢复"/>
                        <Button x:Name="CloseBtn" Content="✕" Width="34" Height="34" FontSize="18"
                                Margin="10,0,0,0"
                                Background="Transparent" Foreground="#9A928A" BorderThickness="0"
                                Click="Close_Click" ToolTip="收起（F8 可再打开）"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="18,0,14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PresetBox" Grid.Column="0" Height="38"
                              ToolTip="选中预设即可应用；右侧「⋯」管理预设（保存/重命名/复制/删除/导入导出）"/>
                    <Button x:Name="PresetApply" Grid.Column="1" Content="应用" Width="64" Height="38"
                            Margin="8,0,0,0" FontSize="14" Background="#4A4438" Foreground="#E8DCC4"
                            BorderThickness="0" Click="PresetApply_Click"
                            ToolTip="用选中的预设覆盖当前面板的所有值并立即应用"/>
                    <Button x:Name="PresetMenuBtn" Grid.Column="2" Content="⋯" Width="46" Height="38"
                            Margin="6,0,0,0" FontSize="18" Background="#35322E" Foreground="#E7E3DC"
                            BorderThickness="0" Click="PresetMenu_Click"
                            ToolTip="保存 / 重命名 / 复制 / 删除 / 导入导出"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel x:Name="Panel" Margin="16,0,12,14"/>
            </ScrollViewer>

            <Border Grid.Row="3" Padding="18,10,14,14"
                    BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Status" Text="就绪" Foreground="#7C766E" FontSize="17"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="RevertBtn" Grid.Column="1" Content="还原" Padding="16,8"
                            FontSize="18" Background="#35322E" Foreground="#A29B92"
                            BorderThickness="0" Click="Revert_Click"
                            ToolTip="丢弃未应用的改动，从磁盘重新读取"/>
                    <Button x:Name="ApplyBtn" Grid.Column="2" Content="应用" Padding="24,8"
                            Margin="8,0,0,0" FontSize="18" FontWeight="SemiBold"
                            Background="#FFD6C4A6" Foreground="#FF201F1E"
                            BorderThickness="0" Click="Apply_Click"
                            ToolTip="把当前面板的改动写入参数表，游戏里随即生效"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
